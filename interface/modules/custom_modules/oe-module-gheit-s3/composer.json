{
    "name": "gheit/oe-module-gheit-s3",
    "description": "Centralized S3 file storage for OpenEMR: patient documents, message attachments, and fax media.",
    "type": "openemr-module",
    "license": "GPL-3.0-only",
    "require": {
        "php": ">=8.1",
        "aws/aws-sdk-php": "^3.300"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "OpenEMR\\Modules\\GheitS3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenEMR\\Modules\\GheitS3\\Tests\\": "tests/Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
