    }

    /* Input wrapper */
    .input-wrap {
        position: relative;
    }

    .input-icon {
        position: absolute;
        left: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #b0bbc8;
        font-size: 14px;
        pointer-events: none;
    }

    .textarea-icon {
        top: 16px;
        transform: none;
    }

    .form-control {
        width: 100%;
        height: 38px;
        border: 1.5px solid #e0e5ec;
        border-radius: 10px;
        padding: 0 14px 0 40px;
        font-size: 14px;
        font-family: 'DM Sans', Arial, sans-serif;
        color: #222;
        background: #f8f9fb;
        transition: border-color .2s, box-shadow .2s, background .2s;
    }

    .form-control::placeholder {
        color: #b8c3ce;
    }

    .form-control:focus {
        outline: none;
        border-color: #174f56;
        background: #fff;
        box-shadow: 0 0 0 3.5px rgba(23,79,86,0.09);
    }

    textarea.form-control {
        height: 90px;
        padding-top: 13px;
        padding-bottom: 13px;
        resize: none;
    }

    /* Buttons */
    .button-row {
        display: flex;
        gap: 12px;
        margin-top: 8px;
    }

    .submit-btn {
        flex: 1;
        background: #264c96;
        color: #fff;
        border: none;
        height: 40px;
        font-size: 15px;
        font-family: 'DM Sans', Arial, sans-serif;
        font-weight: 600;
        cursor: pointer;
        border-radius: 10px;
        transition: background .2s, box-shadow .2s, transform .1s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        letter-spacing: .2px;
        box-shadow: 0 4px 14px rgba(38,76,150,0.25);
    }

    .submit-btn:hover {
        background: #1d3d7a;
        box-shadow: 0 6px 20px rgba(38,76,150,0.32);
    }

    .submit-btn:active {
        transform: scale(0.99);
    }

    .submit-btn:disabled {
        opacity: .65;
        cursor: not-allowed;
    }

    .reset-btn {
        background: #fff;
        border: 1.5px solid #d8dee8;
        height: 40px;
        min-width: 110px;
        font-size: 14px;
        font-family: 'DM Sans', Arial, sans-serif;
        font-weight: 600;
        cursor: pointer;
        border-radius: 10px;
        color: #556070;
        transition: background .2s, border-color .2s;
    }

    .reset-btn:hover {
        background: #f5f7fa;
        border-color: #bec7d4;
    }

    /* Card Footer */
    .card-footer {
        padding: 14px 36px;
        border-top: 1px solid #eef0f3;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: #fafbfc;
    }

    .powered-by {
        font-size: 12px;
        color: #aab3be;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .powered-by i {
