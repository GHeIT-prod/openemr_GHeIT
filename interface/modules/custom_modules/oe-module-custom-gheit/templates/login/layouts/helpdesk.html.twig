        font-size: 13px;
    }

    .footer-links a {
        font-size: 12px;
        color: #264c96;
        text-decoration: none;
        font-weight: 500;
        transition: opacity .2s;
    }

    .footer-links a:hover { opacity: .7; }

    /* Responsive */
    @media (max-width: 520px) {
        .card-header, .card-body, .card-footer {
            padding-left: 22px;
            padding-right: 22px;
        }

        .form-row {
            flex-direction: column;
            gap: 18px;
        }

        .button-row {
            flex-direction: column;
        }

        .reset-btn {
            width: 100%;
        }

        .brand-name { font-size: 22px; }
    }
</style>

<script>
    var zsWebFormMandatoryFields = [
        "First Name",
        "Contact Name",
        "Email",
        "Phone",
        "Subject",
        "Description"
    ];

    var zsFieldsDisplayLabelArray = [
        "First Name",
        "Last Name",
        "Email",
        "Phone",
        "NPI Number",
        "Clinic/Hospital Address"
    ];

    function zsValidateMandatoryFields() {
        for (var index = 0; index < zsWebFormMandatoryFields.length; index++) {
            var fieldObject = document.forms['zsWebToCase_1326210000000474001'][zsWebFormMandatoryFields[index]];
            if (fieldObject) {
                if (fieldObject.value.replace(/^\s+|\s+$/g, '').length == 0) {
                    alert(zsFieldsDisplayLabelArray[index] + ' cannot be empty');
                    fieldObject.focus();
                    return false;
                }
                if (fieldObject.name == 'Email') {
                    if (!fieldObject.value.match(/^([\w_][\w\-_.+\'&]*)@(?=.{4,256}$)(([\w]+)([\-_]*[\w])*[\.])+[a-zA-Z]{2,22}$/)) {
                        alert('Enter a valid email address');
                        fieldObject.focus();
                        return false;
                    }
                }
                if (fieldObject.name == 'Phone') {
                    var digits = fieldObject.value.replace(/\D/g, '');
                    if (digits.length !== 10) {
                        alert('Phone number must be exactly 10 digits');
                        fieldObject.focus();
                        return false;
                    }
                }
            }
        }
        document.getElementById('zsSubmitButton_1326210000000474001').setAttribute('disabled', 'disabled');
        return true;
    }

    function zsResetWebForm(webFormId) {
        document.forms['zsWebToCase_' + webFormId].reset();
        document.getElementById('zsSubmitButton_1326210000000474001').removeAttribute('disabled');
    }
</script>

</head>
