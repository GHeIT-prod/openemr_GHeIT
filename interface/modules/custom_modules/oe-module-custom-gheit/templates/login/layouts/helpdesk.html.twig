                <!-- Email -->
                <div class="form-group">
                    <label><i class="fa-regular fa-envelope"></i> Email Address</label>
                    <div class="input-wrap">
                        <i class="fa-regular fa-envelope input-icon"></i>
                        <input type="text" maxlength="120" name="Email" class="form-control" placeholder="jane.doe@example.com"/>
                    </div>
                </div>

                <!-- Phone -->
                <div class="form-group">
                    <label><i class="fa-solid fa-phone"></i> Phone Number</label>
                    <div class="input-wrap">
                        <i class="fa-solid fa-phone input-icon"></i>
                        <input type="text" maxlength="120" name="Phone" class="form-control" placeholder="(555) 000-0000"/>
                    </div>
